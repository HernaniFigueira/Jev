{
  "buildCommand": "python3 -m pip install -r requirements.txt",
  "devCommand": "uvicorn app.server:app --host 0.0.0.0 --port 3000",
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.3.0",
      "maxDuration": 60
    }
  }
}
